{
  "name": "notis-apps",
  "version": "0.0.0",
  "private": true,
  "description": "Public registry of Notis apps. Apps live under apps/<slug>/; merging to main publishes them to the Notis registry.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "validate": "tsx scripts/validate-manifest.ts",
    "check-semver": "tsx scripts/ensure-semver-bump.ts",
    "detect-changed": "tsx scripts/detect-changed-apps.ts",
    "publish-webhook": "tsx scripts/publish-webhook.ts",
    "typecheck:scripts": "tsc -p scripts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
