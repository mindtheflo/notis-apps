# Shared secret used by the merge-publish CI workflow to sign the webhook
# that tells the Notis server a new app version is available.
# Generate with: openssl rand -base64 48
NOTIS_REGISTRY_WEBHOOK_SECRET=replace-me

# Notis server URL that receives the publish webhook.
# Empty / unset = dry-run mode (workflow prints payload but does not POST).
NOTIS_REGISTRY_WEBHOOK_URL=

# Supabase storage credentials for uploading bundles to the registry bucket.
# The server re-downloads the bundle post-webhook to verify bundle_sha256.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=app-code
