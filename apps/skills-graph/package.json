{
  "name": "skill-graph",
  "version": "0.2.12",
  "notisAppVersion": "0.2.12",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --configLoader runner",
    "dev": "vite",
    "test": "tsx --test lib/skill-links.test.ts lib/force-layout.test.ts lib/graph-view.test.ts lib/skills-api.test.ts",
    "typecheck": "tsc --noEmit",
    "fixtures": "tsx scripts/build-fixtures.ts",
    "generate-entry": "tsx ../../scripts/generate-entry.ts .",
    "prebuild": "npm run generate-entry",
    "postbuild": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('.notis/output/bundle','dist',{recursive:true})\""
  },
  "dependencies": {
    "@notis/sdk": "file:./packages/sdk",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
